{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/finance_research_block_schema.json",
  "title": "Finance Research Block Schema",
  "description": "Typed assistant-response schema for structured Block[] artifacts rendered by Chat, Analyze, and findings surfaces.",
  "type": "object",
  "required": [
    "blocks"
  ],
  "properties": {
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "SubjectKind": {
      "type": "string",
      "description": "Canonical subject discriminator. Ticker is a listing locator, not canonical identity.",
      "enum": [
        "issuer",
        "instrument",
        "listing",
        "theme",
        "macro_topic",
        "portfolio",
        "screen"
      ]
    },
    "SubjectRef": {
      "type": "object",
      "description": "kind determines whether the id points to an issuer, instrument, listing, theme, macro topic, portfolio, or screen.",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SubjectKind"
        },
        "id": {
          "$ref": "#/$defs/UUID"
        }
      },
      "additionalProperties": false
    },
    "DisclosureTier": {
      "type": "string",
      "enum": [
        "real_time",
        "delayed_15m",
        "eod",
        "filing_time",
        "estimate",
        "candidate",
        "tertiary_source"
      ]
    },
    "DataRef": {
      "description": "Canonical backend binding for a block. Historical dataRef/queryRef language maps to data_ref in this schema.",
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "InteractiveSpec": {
      "type": "object",
      "properties": {
        "ranges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sort_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "range_end_max": {
          "type": "string"
        },
        "hover_details": {
          "type": "boolean"
        },
        "collapsible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "BaseBlock": {
      "description": "Shared render, audit, provenance, and snapshot binding fields for every block.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "snapshot_id",
        "data_ref",
        "source_refs",
        "as_of"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "snapshot_id": {
          "$ref": "#/$defs/UUID"
        },
        "data_ref": {
          "$ref": "#/$defs/DataRef"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UUID"
          }
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string"
        },
        "disclosure_tier": {
          "$ref": "#/$defs/DisclosureTier"
        },
        "interactive": {
          "$ref": "#/$defs/InteractiveSpec"
        }
      }
    },
    "TextSegment": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        },
        "tone": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "neutral"
          ]
        }
      },
      "additionalProperties": false
    },
    "RefSegment": {
      "type": "object",
      "required": [
        "type",
        "ref_kind",
        "ref_id"
      ],
      "properties": {
        "type": {
          "const": "ref"
        },
        "ref_kind": {
          "type": "string",
          "enum": [
            "fact",
            "claim",
            "event"
          ]
        },
        "ref_id": {
          "$ref": "#/$defs/UUID"
        },
        "format": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RichText": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rich_text"
            },
            "segments": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/TextSegment"
                  },
                  {
                    "$ref": "#/$defs/RefSegment"
                  }
                ]
              }
            }
          },
          "required": [
            "segments"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Section": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "section"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Block"
              }
            },
            "collapsible": {
              "type": "boolean"
            }
          },
          "required": [
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "MetricCell": {
      "type": "object",
      "required": [
        "label",
        "value_ref"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "value_ref": {
          "$ref": "#/$defs/UUID"
        },
        "format": {
          "type": "string"
        },
        "delta_ref": {
          "$ref": "#/$defs/UUID"
        }
      },
      "additionalProperties": false
    },
    "MetricRow": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "metric_row"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MetricCell"
              }
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Table": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "object"
                  ]
                }
              }
            }
          },
          "required": [
            "columns",
            "rows"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "SeriesPoint": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": [
            "string",
            "number"
          ]
        },
        "y": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Series": {
      "type": "object",
      "required": [
        "name",
        "points"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          }
        },
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LineChart": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "line_chart"
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Series"
              }
            },
            "x_type": {
              "type": "string",
              "enum": [
                "time",
                "category"
              ]
            },
            "y_format": {
              "type": "string"
            }
          },
          "required": [
            "series",
            "x_type"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "RevenueBars": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "revenue_bars"
            },
            "bars": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "value_ref"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value_ref": {
                    "$ref": "#/$defs/UUID"
                  },
                  "delta_ref": {
                    "$ref": "#/$defs/UUID"
                  },
                  "magnitude": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "format": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "bars"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "PerfComparison": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "perf_comparison"
            },
            "subject_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SubjectRef"
              }
            },
            "default_range": {
              "type": "string"
            },
            "basis": {
              "type": "string"
            },
            "normalization": {
              "type": "string",
              "enum": [
                "raw",
                "pct_return",
                "index_100"
              ]
            }
          },
          "required": [
            "subject_refs",
            "default_range",
            "basis",
            "normalization"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "SegmentDonut": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "segment_donut"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value_ref"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value_ref": {
                    "$ref": "#/$defs/UUID"
                  },
                  "definition_as_of": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "additionalProperties": false
              }
            },
            "coverage_warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "segments"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "SegmentTrajectory": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "segment_trajectory"
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Series"
              }
            }
          },
          "required": [
            "series"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "MetricsComparisonCell": {
      "type": "object",
      "required": [
        "value_ref"
      ],
      "properties": {
        "value_ref": {
          "$ref": "#/$defs/UUID"
        },
        "format": {
          "type": "string"
        },
        "tone": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "neutral"
          ]
        }
      },
      "additionalProperties": false
    },
    "MetricsComparison": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "metrics_comparison"
            },
            "subjects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SubjectRef"
              }
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cells": {
              "description": "Value matrix indexed [subjectIndex][metricIndex]. Optional: when absent the block renders metric labels with empty cells. A null entry is a gap (the subject lacks that metric) and renders as an em-dash.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "$ref": "#/$defs/MetricsComparisonCell" },
                    { "type": "null" }
                  ]
                }
              }
            },
            "primary_subject_ref": {
              "description": "The queried subject to emphasize among the compared peers.",
              "$ref": "#/$defs/SubjectRef"
            }
          },
          "required": [
            "subjects",
            "metrics"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "AnalystConsensus": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "analyst_consensus"
            },
            "analyst_count_ref": {
              "$ref": "#/$defs/UUID"
            },
            "distribution": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "bucket",
                  "count_ref"
                ],
                "properties": {
                  "bucket": {
                    "type": "string"
                  },
                  "count_ref": {
                    "$ref": "#/$defs/UUID"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "coverage_warning": {
              "type": "string"
            }
          },
          "required": [
            "analyst_count_ref",
            "distribution"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "PriceTargetRange": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "price_target_range"
            },
            "current_price_ref": {
              "$ref": "#/$defs/UUID"
            },
            "low_ref": {
              "$ref": "#/$defs/UUID"
            },
            "avg_ref": {
              "$ref": "#/$defs/UUID"
            },
            "high_ref": {
              "$ref": "#/$defs/UUID"
            },
            "upside_ref": {
              "$ref": "#/$defs/UUID"
            },
            "display": {
              "type": "object",
              "required": [
                "current",
                "low",
                "avg",
                "high"
              ],
              "properties": {
                "current": { "$ref": "#/$defs/PriceTargetPoint" },
                "low": { "$ref": "#/$defs/PriceTargetPoint" },
                "avg": { "$ref": "#/$defs/PriceTargetPoint" },
                "high": { "$ref": "#/$defs/PriceTargetPoint" }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "current_price_ref",
            "low_ref",
            "avg_ref",
            "high_ref"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "PriceTargetPoint": {
      "type": "object",
      "required": [
        "position",
        "format"
      ],
      "properties": {
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "format": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EpsSurprise": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "eps_surprise"
            },
            "quarters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "estimate_ref",
                  "actual_ref"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "estimate_ref": {
                    "$ref": "#/$defs/UUID"
                  },
                  "actual_ref": {
                    "$ref": "#/$defs/UUID"
                  },
                  "surprise_ref": {
                    "$ref": "#/$defs/UUID"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "quarters"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "FilingsList": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "filings_list"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "document_id",
                  "form",
                  "filed_at"
                ],
                "properties": {
                  "document_id": {
                    "$ref": "#/$defs/UUID"
                  },
                  "form": {
                    "type": "string"
                  },
                  "filed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "period": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "NewsCluster": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "news_cluster"
            },
            "cluster_id": {
              "$ref": "#/$defs/UUID"
            },
            "headline": {
              "type": "string"
            },
            "claim_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UUID"
              }
            },
            "document_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UUID"
              }
            }
          },
          "required": [
            "cluster_id",
            "headline",
            "claim_refs"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "FindingCard": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "finding_card"
            },
            "finding_id": {
              "$ref": "#/$defs/UUID"
            },
            "headline": {
              "type": "string"
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "subject_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SubjectRef"
              }
            }
          },
          "required": [
            "finding_id",
            "headline",
            "severity"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "SentimentTrend": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sentiment_trend"
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Series"
              }
            }
          },
          "required": [
            "series"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "MentionVolume": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "mention_volume"
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Series"
              }
            }
          },
          "required": [
            "series"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Sources": {
      "description": "Provenance block required whenever external evidence appears in the answer.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sources"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "source_id",
                  "label"
                ],
                "properties": {
                  "source_id": {
                    "$ref": "#/$defs/UUID"
                  },
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Disclosure": {
      "description": "Disclosure block for trust and compliance notes; orchestration may inject it.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "disclosure"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "FinancialUnit": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "currency"
          ],
          "properties": {
            "kind": {
              "enum": [
                "currency",
                "currency_per_share"
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ratio",
                "percent",
                "percentage_points",
                "basis_points",
                "shares",
                "count"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FinancialPresentationLabel": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "slot_id"
          ],
          "properties": {
            "kind": {
              "const": "subject"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "slot_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "enum": [
                "measure",
                "period"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FinancialPresentedPayload": {
      "description": "Server-generated text only. A value's text is a formatted number; comparative words (highest, above, all) appear only in evaluated predicate or ranking results, and an incomplete ranking can never name a leader.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "full_text",
            "value",
            "unit",
            "exact"
          ],
          "properties": {
            "kind": {
              "const": "value"
            },
            "text": {
              "type": "string",
              "pattern": "^(?:[A-Z]{3} )?-?[0-9][0-9,]*(?:\\.[0-9]+)?(?:%| pp| bp| shares| per share)?$"
            },
            "full_text": {
              "type": "string",
              "pattern": "^(?:[A-Z]{3} )?-?[0-9][0-9,]*(?:\\.[0-9]+)?(?:%| pp| bp| shares| per share)?$"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
            },
            "unit": {
              "$ref": "#/$defs/FinancialUnit"
            },
            "exact": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "outcome"
          ],
          "properties": {
            "kind": {
              "const": "predicate"
            },
            "text": {
              "type": "string"
            },
            "outcome": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "complete",
            "order",
            "leader_label_ids"
          ],
          "properties": {
            "kind": {
              "const": "ranking"
            },
            "text": {
              "type": "string"
            },
            "complete": {
              "type": "boolean"
            },
            "order": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "subject_label_id",
                  "rank"
                ],
                "properties": {
                  "subject_label_id": {
                    "type": "string",
                    "pattern": "^subject:[a-z][a-z0-9_]{0,63}$"
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "leader_label_ids": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^subject:[a-z][a-z0-9_]{0,63}$"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "leader_label_ids": {
                "type": "null"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "reason_code"
          ],
          "properties": {
            "kind": {
              "const": "gap"
            },
            "text": {
              "type": "string"
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FinancialPresentedResult": {
      "type": "object",
      "required": [
        "result_id",
        "output_id",
        "disposition",
        "subject_label_id",
        "measure_label_id",
        "period_label_id",
        "presented",
        "result_hash"
      ],
      "properties": {
        "result_id": {
          "$ref": "#/$defs/UUID"
        },
        "output_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "disposition": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "subject_label_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^subject:[a-z][a-z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "measure_label_id": {
          "type": "string",
          "pattern": "^measure:m[0-9]+$"
        },
        "period_label_id": {
          "type": "string",
          "pattern": "^period:p[0-9]+$"
        },
        "presented": {
          "$ref": "#/$defs/FinancialPresentedPayload"
        },
        "result_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "FinancialPresentation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "result_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "scalar",
                "predicate",
                "gap"
              ]
            },
            "result_id": {
              "$ref": "#/$defs/UUID"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "caption",
            "columns",
            "rows",
            "ascending"
          ],
          "properties": {
            "kind": {
              "const": "table"
            },
            "caption": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "column_id",
                  "measure_label_id",
                  "period_label_id"
                ],
                "properties": {
                  "column_id": {
                    "type": "string",
                    "pattern": "^c[0-9]+$"
                  },
                  "measure_label_id": {
                    "type": "string",
                    "pattern": "^measure:m[0-9]+$"
                  },
                  "period_label_id": {
                    "type": "string",
                    "pattern": "^period:p[0-9]+$"
                  }
                },
                "additionalProperties": false
              }
            },
            "rows": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "subject_label_id",
                  "cells"
                ],
                "properties": {
                  "subject_label_id": {
                    "type": "string",
                    "pattern": "^subject:[a-z][a-z0-9_]{0,63}$"
                  },
                  "cells": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/UUID"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "ascending": {
              "type": "object",
              "propertyNames": {
                "pattern": "^c[0-9]+$"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "subject_label_id",
            "measure_label_id",
            "points"
          ],
          "properties": {
            "kind": {
              "const": "series"
            },
            "subject_label_id": {
              "type": "string",
              "pattern": "^subject:[a-z][a-z0-9_]{0,63}$"
            },
            "measure_label_id": {
              "type": "string",
              "pattern": "^measure:m[0-9]+$"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "period_label_id",
                  "result_id"
                ],
                "properties": {
                  "period_label_id": {
                    "type": "string",
                    "pattern": "^period:p[0-9]+$"
                  },
                  "result_id": {
                    "$ref": "#/$defs/UUID"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FinancialAnswerContentV1": {
      "type": "object",
      "required": [
        "presentation_version",
        "template_version",
        "run_id",
        "unit_id",
        "knowledge_cutoff",
        "coverage",
        "labels",
        "results",
        "presentations"
      ],
      "properties": {
        "presentation_version": {
          "const": "financial-presentation.v1"
        },
        "template_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "$ref": "#/$defs/UUID"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "knowledge_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "coverage": {
          "type": "object",
          "required": [
            "state",
            "requested",
            "verified"
          ],
          "properties": {
            "state": {
              "enum": [
                "complete",
                "partial",
                "none"
              ]
            },
            "requested": {
              "type": "integer",
              "minimum": 0
            },
            "verified": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(subject:[a-z][a-z0-9_]{0,63}|measure:m[0-9]+|period:p[0-9]+)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FinancialPresentationLabel"
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FinancialPresentedResult"
          }
        },
        "presentations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FinancialPresentation"
          }
        }
      },
      "additionalProperties": false
    },
    "FinancialAnswer": {
      "description": "A certified quantitative answer. Every string is server-generated from committed results; there is no title or prose field, so a model cannot add unverified numerical or comparative claims.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseBlock"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "financial_answer"
            },
            "presentation_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "financial": {
              "description": "Generated by the snapshot verifier from the results it verified; callers cannot supply one. A version this schema does not know is accepted only so clients can show it as unsupported; it is never rendered as verified content.",
              "type": "object",
              "required": [
                "presentation_version"
              ],
              "properties": {
                "presentation_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "if": {
                "properties": {
                  "presentation_version": {
                    "const": "financial-presentation.v1"
                  }
                }
              },
              "then": {
                "$ref": "#/$defs/FinancialAnswerContentV1"
              }
            }
          },
          "required": [
            "presentation_hash",
            "financial"
          ]
        }
      ],
      "not": {
        "required": [
          "title"
        ]
      },
      "unevaluatedProperties": false
    },
    "Block": {
      "oneOf": [
        {
          "$ref": "#/$defs/RichText"
        },
        {
          "$ref": "#/$defs/Section"
        },
        {
          "$ref": "#/$defs/MetricRow"
        },
        {
          "$ref": "#/$defs/Table"
        },
        {
          "$ref": "#/$defs/LineChart"
        },
        {
          "$ref": "#/$defs/RevenueBars"
        },
        {
          "$ref": "#/$defs/PerfComparison"
        },
        {
          "$ref": "#/$defs/SegmentDonut"
        },
        {
          "$ref": "#/$defs/SegmentTrajectory"
        },
        {
          "$ref": "#/$defs/MetricsComparison"
        },
        {
          "$ref": "#/$defs/AnalystConsensus"
        },
        {
          "$ref": "#/$defs/PriceTargetRange"
        },
        {
          "$ref": "#/$defs/EpsSurprise"
        },
        {
          "$ref": "#/$defs/FilingsList"
        },
        {
          "$ref": "#/$defs/NewsCluster"
        },
        {
          "$ref": "#/$defs/FindingCard"
        },
        {
          "$ref": "#/$defs/SentimentTrend"
        },
        {
          "$ref": "#/$defs/MentionVolume"
        },
        {
          "$ref": "#/$defs/Sources"
        },
        {
          "$ref": "#/$defs/Disclosure"
        },
        {
          "$ref": "#/$defs/FinancialAnswer"
        }
      ]
    }
  }
}
