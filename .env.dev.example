DEV_POSTGRES_PORT=54329
DEV_MINIO_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
WEB_PORT=5173
CHAT_PORT=4310
RESOLVER_PORT=4311
DEV_API_PORT=4312
WATCHLISTS_PORT=4313
MARKET_PORT=4321
FUNDAMENTALS_PORT=4322
SCREENER_PORT=4323
PORTFOLIO_PORT=4333
HOME_PORT=4334
EVIDENCE_PORT=4335
DEV_PROVIDERS_PORT=4336
ANALYST_GRIDS_PORT=8093
# Comma-separated tickers for the Home market-pulse strip. On startup, dev
# hydrates these through provider-backed identity discovery when POLYGON_API_KEY
# is set; otherwise they remain unavailable rather than falling back to seeds.
HOME_PULSE_TICKERS=AAPL,MSFT,GOOGL
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=postgres
DEV_POSTGRES_DB=market_agent
MA_FLAG_PLACEHOLDER_API=true
MA_FLAG_SHOW_DEV_BANNER=false
MA_FLAG_LLM_SETTINGS=true
VITE_MA_FLAG_LLM_SETTINGS=true

# Which services dev-shell runs: full (everything) or chat (one process serving web,
# chat, resolver, dev-api, market, fundamentals on WEB_PORT + Postgres; the rest
# parked, discovery included).
DEV_PROFILE=full

# No API keys: seed the golden frozen dataset and answer with recorded model
# replies (the golden conversation only). Overrides the LLM settings below.
DEV_NO_KEYS=false

# Development mode (README "Development modes"): ui = replay recorded API traffic, no
# database/services/network (with DEV_PROFILE=chat); analyst = frozen dataset + your live
# LLM, logging model latency/tokens per call; data = live providers. Unset = default.
# DEV_MODE=analyst

# Discovery campaigns are disabled until the recorded-fixture release review is
# complete. Enabling the worker also requires the adapter-composition module
# and the existing model/reference settings below; neither secrets nor model
# configuration are persisted in campaign snapshots.
DISCOVERY_ENABLED=false
DISCOVERY_WORKER_POLL_MS=1000
DISCOVERY_SEARCH_API_KEY=
# DISCOVERY_WORKER_MODULE=/absolute/path/to/discovery-worker-runtime.ts

# Local LLM channel settings. The dev shell exports LLM_SETTINGS_ENV_FILE to
# .env.dev so the Settings UI can update these fields without restarting the
# shell. API keys are masked in the UI and preserved when saved unchanged.
LLM_CHANNELS=
# LLM_OPENAI_PROTOCOL=openai
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_MODELS=gpt-4.1,o3
# LLM_DEEPSEEK_PROTOCOL=openai-compatible
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_DEEPSEEK_API_KEY=
# LLM_DEEPSEEK_MODELS=deepseek-chat
# Reasoning effort per model comes from pi-ai's model catalog (matched by base URL
# and model id). For a model newer than the catalog, list it here to send it
# OpenAI-style reasoning_effort; unlisted unknown models get the provider default.
# LLM_DEEPSEEK_REASONING_MODELS=
# LITELLM_MODEL=openai/gpt-4.1
# LITELLM_FALLBACK_MODELS=deepseek/deepseek-chat,openai/o3
# AGENT_LITELLM_MODEL=openai/o3
# Anthropic (Claude Messages API at api.anthropic.com; no base URL needed). The key is
# a Console API key from the org linked to the Max plan's monthly credits; plan OAuth
# tokens aren't covered. These models never get a temperature (they reject it). pi-ai's
# catalog doesn't list claude-haiku-5-5 yet, so it is named a reasoning model here to get
# effort control. A refusal or an exhausted credit balance falls back to
# LITELLM_FALLBACK_MODELS, here an openai-compatible OpenCode Go channel named opencode.
# LLM_ANTHROPIC_PROTOCOL=anthropic
# LLM_ANTHROPIC_API_KEY=
# LLM_ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
# LLM_ANTHROPIC_REASONING_MODELS=claude-haiku-5-5
# LITELLM_MODEL=anthropic/claude-sonnet-5-5
# EXTRACTION_LITELLM_MODEL=anthropic/claude-haiku-5-5
# LITELLM_FALLBACK_MODELS=opencode/qwen3.8-max
# Extraction calls (the SEC 8-K and earnings-release CLIs, analyst-grid reader columns,
# chat's metric scope proposal) use EXTRACTION_LITELLM_MODEL, then the fallbacks; unset,
# they use LITELLM_MODEL like every other call.
# JUDGE_LITELLM_MODEL=anthropic/claude-haiku-5-5
# The judge checks each analyst inference in a chat answer against what it rests on, on
# JUDGE_LITELLM_MODEL alone, with no fallback. Chat shows the answer's figures at once and
# each inference only once the judge finds it entailed; unset, chat shows no inferences.
# The verdicts are logged and kept in the turn's trace (CHAT_TRACE_DIR). The answer lab's
# judge-mutations, unset, uses LITELLM_MODEL and the fallbacks.
# Chat asks the model which metrics and facets a question asks for or turns off, from
# fixed catalogs, before reading figures (one short call per turn). Off, a follow-up
# keeps the previous scope except for any period it names (FY2026, Q3, YTD), and a
# fresh question gets the plain answer for the companies it names.
# CHAT_SCOPE_PROPOSAL=off

# Optional provider wiring. Without POLYGON_API_KEY, provider-backed ticker and
# market surfaces return unavailable/not_found instead of fixture data. With a
# key, resolver startup/on-demand discovery persists stock identities and market
# requests cache Polygon quotes/bars in Postgres.
POLYGON_API_KEY=
# RESOLVER_POLYGON_REFERENCE_BASE_URL=https://api.polygon.io
# POLYGON_API_BASE_URL=https://api.polygon.io

# Explicit opt-in for unofficial local-dev provider fallback. When enabled,
# dev-shell starts services/dev-providers and resolver/market can use yfinance
# after provider-backed Polygon lookup/cache paths miss or are unavailable.
ENABLE_UNOFFICIAL_DEV_PROVIDERS=false
# DEV_PROVIDERS_ORIGIN=http://127.0.0.1:4336

# Screener-artifacts ETL — ingests the xang1234/stock-screener weekly-reference
# GitHub Release into Postgres (services/screener-artifacts). US-first.
SCREENER_ARTIFACTS_ENABLE=false
# SCREENER_ARTIFACTS_REPO=xang1234/stock-screener
# SCREENER_ARTIFACTS_MARKETS=US
# SCREENER_ARTIFACTS_RELEASE_BASE_URL=https://github.com/xang1234/stock-screener/releases/download
# Which candidate set the screener serves: 'reported' (SEC margins/PE, default) or
# 'vendor' (the bulk screener-artifacts momentum/technical universe).
SCREENER_CANDIDATE_SOURCE=reported

# Optional open reference identity providers. These are discovery/enrichment
# sources that fill missing resolver identity fields after paid discovery misses.
# They do not overwrite existing SEC/Polygon/local identifiers.
OPENFIGI_REFERENCE_ENABLED=false
OPENFIGI_API_KEY=
OPENFIGI_API_BASE_URL=https://api.openfigi.com
GLEIF_REFERENCE_ENABLED=false
GLEIF_API_BASE_URL=https://api.gleif.org/api/v1
NASDAQ_TRADER_REFERENCE_ENABLED=false
NASDAQ_TRADER_BASE_URL=https://www.nasdaqtrader.com

# Optional free Stooq EOD market fallback. This is daily historical bars only;
# it must not be used as a realtime quote or intraday source.
STOOQ_MARKET_ENABLED=false
STOOQ_MARKET_BASE_URL=https://stooq.com/q/d/l/

# Required by SEC EDGAR for live companyfacts ingestion. Include an app/contact
# string you control, e.g. "market-agent-dev you@example.com".
SEC_EDGAR_USER_AGENT=
# SEC_EDGAR_BASE_URL=https://data.sec.gov

# GDELT public news discovery. This integration is metadata-only by default;
# snippets may be passed transiently to reader tools, but full article bodies
# are not stored unless a later source-specific license review explicitly
# permits it.
GDELT_DISCOVERY_ENABLED=false
GDELT_DOC_API_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_DISCOVERY_STORE_POLICY=metadata_only
GDELT_DISCOVERY_DEFAULT_MAX_RECORDS=100
GDELT_DISCOVERY_RATE_LIMIT_PER_SECOND=1

# Object storage for raw document blobs (P3.1).
# BLOB_STORE_BACKEND=memory uses MemoryObjectStore (in-process, dev only).
# BLOB_STORE_BACKEND=s3 uses S3ObjectStore against any S3-compatible API.
# The MinIO defaults below match the docker-compose.dev.yml service.
BLOB_STORE_BACKEND=memory
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=evidence-blobs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Verified financial answers. Each surface is off (legacy numbers, labelled
# legacy) or enforce (numbers come only from certified calculations; anything
# the engine cannot verify is shown as a gap, never as legacy prose). Unset
# means off; any other value stops startup. With any surface on, a service
# refuses to start until the schema and version registry are ready
# (financial-engine/src/readiness.ts).
# Turning these on never enables Discovery; DISCOVERY_ENABLED alone does that.
CHAT_FINANCIAL_MODE=off
# Chat answers that fail verification: strict (default) shows an error and nothing
# else; display_unverified shows the blocks labelled "Unverified" with the failure
# reasons and never saves them. Development only: the chat server refuses to start
# with display_unverified when NODE_ENV=production.
# CHAT_VERIFICATION_MODE=display_unverified
ANALYZE_FINANCIAL_MODE=off
GRID_FINANCIAL_MODE=off
THESIS_FINANCIAL_MODE=off
# Supervised recovery of interrupted financial runs (dev-api).
FINANCIAL_WORKER_ENABLED=false
# FINANCIAL_WORKER_INTERVAL_MS=5000
